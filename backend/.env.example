# ---- Core ----------------------------------------------------------------
PORT=1369
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API.
# Leave empty for the unified deploy (frontend served by this server).
CORS_ORIGINS=

# ---- Event ingestion -----------------------------------------------------
# Two providers work with no key at all (developers.events, NYC Parks).
# Add a free Ticketmaster key to unlock local concerts, sports and theatre:
#   https://developer-acct.ticketmaster.com/user/register
TICKETMASTER_API_KEY=

# Cities queried on each Ticketmaster sync.
SYNC_CITIES=Bengaluru,Mumbai,Delhi,London,New York,San Francisco,Berlin,Singapore

# Daily refresh schedule (standard 5-field cron).
SYNC_CRON=15 3 * * *
SYNC_TIMEZONE=Etc/UTC

# Run a catch-up sync at boot when the last one is older than this many hours.
SYNC_ON_BOOT=true
SYNC_STALE_HOURS=20

# Set to enable POST /api/sync/run (send it as the x-admin-token header).
ADMIN_SYNC_TOKEN=
