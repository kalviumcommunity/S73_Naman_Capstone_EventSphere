meta {
  name: 01 Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "demo@eventsphere.com",
    "password": "demo123456"
  }
}

script:post-response {
  // Store the token so later requests in this collection can use it.
  bru.setEnvVar("token", res.body.token);
  bru.setEnvVar("userId", res.body.user.id);
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}
